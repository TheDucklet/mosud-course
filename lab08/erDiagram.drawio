        </mxCell>

        <mxCell id="olist_products" value="olist.products" style="swimlane;fontStyle=1;startSize=26;fillColor=#fdf1e7;strokeColor=#b0602a;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="olist_products_id" value="PK product_id: text" style="text;html=1;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="olist_products">
