        </mxCell>
        <mxCell id="e_wh_tr_src_l" value="1 : N источник RESTRICT" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_wh_tr_src">
          <mxGeometry x="-0.25" y="10" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_wh_tr_dst" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#b3261e;" edge="1" parent="1" source="warehouses" target="transfers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_wh_tr_dst_l" value="1 : N назначение RESTRICT" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_wh_tr_dst">
          <mxGeometry x="-0.25" y="30" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_tr_ti" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#333333;" edge="1" parent="1" source="transfers" target="transfer_items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tr_ti_l" value="1 : N (transfer_id) CASCADE" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_tr_ti">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_prod_ti" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#b3261e;dashed=1;" edge="1" parent="1" source="olist_products" target="transfer_items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_prod_ti_l" value="1 : N (product_id) RESTRICT" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_prod_ti">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_inv_tr" value="резервирует остатки (концептуально)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;startArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="inventory" target="transfers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_sell_prod" value="1 : N (поставщик)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#b0602a;dashed=1;" edge="1" parent="1" source="olist_sellers" target="olist_products">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Легенда: PK — первичный ключ; UQ — альтернативный/составной уникальный ключ; FK — внешний ключ; ERone/ERmany — кратность 1:N; RESTRICT — ON DELETE RESTRICT; CASCADE — ON DELETE CASCADE. Сущности в голубых рамках — новые таблицы схемы lab, в оранжевых — исходные объекты Olist (только внешние ключи, без копирования данных)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#fafafa;strokeColor=#cccccc;" vertex="1" parent="1">
