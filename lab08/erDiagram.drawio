        <mxCell id="tr_shipped" value="shipped_at: timestamptz" style="text;html=1;align=left;spacingLeft=28;" vertex="1" parent="transfers">
          <mxGeometry y="146" width="290" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tr_received" value="received_at: timestamptz CHECK &gt;= shipped_at" style="text;html=1;align=left;spacingLeft=28;" vertex="1" parent="transfers">
          <mxGeometry y="166" width="290" height="20" as="geometry" />
        </mxCell>

        <mxCell id="transfer_items" value="lab.warehouse_transfer_items" style="swimlane;fontStyle=1;startSize=26;fillColor=#eef4fb;strokeColor=#1b5e9b;html=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="540" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="ti_tr" value="PK FK transfer_id: integer NOT NULL" style="text;html=1;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="transfer_items">
          <mxGeometry y="26" width="280" height="20" as="geometry" />
