        <mxCell id="ti_p" value="PK FK product_id: text NOT NULL" style="text;html=1;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="transfer_items">
          <mxGeometry y="46" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ti_q" value="qty: integer NOT NULL CHECK &gt; 0" style="text;html=1;align=left;spacingLeft=28;" vertex="1" parent="transfer_items">
          <mxGeometry y="66" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ti_note" value="note: varchar(120)" style="text;html=1;align=left;spacingLeft=28;" vertex="1" parent="transfer_items">
          <mxGeometry y="86" width="280" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e_wh_inv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#b3261e;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.2;" edge="1" parent="1" source="warehouses" target="inventory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_wh_inv_l" value="1 : N (warehouse_id) RESTRICT" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_wh_inv">
          <mxGeometry x="-0.1" y="-10" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_prod_inv" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERzeroToOne;strokeColor=#b3261e;" edge="1" parent="1" source="olist_products" target="inventory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_prod_inv_l" value="0..1 : N (product_id)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e_prod_inv">
          <mxGeometry x="-0.2" relative="1" as="geometry">
