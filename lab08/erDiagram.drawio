          </mxGeometry>
        </mxCell>
        <mxCell id="e_wh_tr_src" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#b3261e;" edge="1" parent="1" source="warehouses" target="transfers">
